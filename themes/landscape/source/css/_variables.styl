// Config
support-for-ie = false
vendor-prefixes = webkit moz ms official

// Colors
color-default = #4a5568
color-grey = #718096
color-border = #e2e8f0
color-link = #3182ce
color-background = #f7fafc
color-sidebar-text = #4a5568
color-widget-background = #f7fafc
color-widget-border = #e2e8f0
color-footer-background = #2d3748
color-mobile-nav-background = #1a202c
color-twitter = #1da1f2
color-facebook = #3b5998
color-pinterest = #e60023
color-linkedin = #0077b5

// Fonts
font-sans = -apple-system, BlinkMacSystemFont,
    "PingFang SC", "Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell",
    "Fira Sans", "Droid Sans", "Helvetica Neue",
    "Microsoft YaHei", sans-serif
font-serif = Georgia, "Times New Roman", serif
font-mono = "Source Code Pro", Consolas, Monaco, Menlo, Consolas, monospace
font-icon = FontAwesome
font-icon-path = "fonts/fontawesome-webfont"
font-icon-version = "4.7.0"
font-size = 16px
line-height = 1.7em
line-height-title = 1.2em

// Header
logo-size = 48px
subtitle-size = 18px
banner-height = 320px
banner-url = hexo-config("banner")

sidebar = hexo-config("sidebar")

// Layout
block-margin = 40px
article-padding = 30px
mobile-nav-width = 280px
main-column = 9
sidebar-column = 3

if sidebar and sidebar isnt bottom
  _sidebar-column = sidebar-column
else
  _sidebar-column = 0

// Grids
column-width = 80px
gutter-width = 25px
columns = main-column + _sidebar-column

// Media queries
mq-mobile = "screen and (max-width: 479px)"
mq-tablet = "screen and (min-width: 480px) and (max-width: 767px)"
mq-normal = "screen and (min-width: 768px)"